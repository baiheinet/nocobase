{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {}
  },
  "include": ["src/client/**/*", "src/client-v2/**/*"],
  "exclude": ["node_modules", "dist"]
}
